# Normalize text files; Unity writes LF, keep it that way on every OS
* text=auto eol=lf

# Unity YAML
*.unity            text eol=lf
*.prefab           text eol=lf
*.asset            text eol=lf
*.meta             text eol=lf
*.mat              text eol=lf
*.anim             text eol=lf
*.controller       text eol=lf
*.inputactions     text eol=lf
*.scenetemplate    text eol=lf

# Binary
*.png              binary
*.jpg              binary
*.psd              binary
*.wav              binary
*.mp3              binary
*.ogg              binary
*.ttf              binary
*.otf              binary

# Generated by the Input System package
Assets/Scripts/Input/PlayerInputActions.cs linguist-generated=true

# Unity package code shipped inside Assets/ (TextMesh Pro shaders): exclude from language stats
Assets/TextMesh[[:space:]]Pro/** linguist-vendored
